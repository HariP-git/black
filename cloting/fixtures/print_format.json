    "paper_size": "A5",
    "html": "<style>\n@page { size: A5; margin: 8mm; }\n.print-format { color: #111; font-family: Arial, sans-serif; font-size: 10pt; }\n.header { border-bottom: 2px solid #111; padding-bottom: 8px; }\n.title { font-size: 18pt; font-weight: 700; letter-spacing: 1px; }\n.meta { margin: 12px 0; width: 100%; }\n.meta td { padding: 4px; vertical-align: top; }\n.label { color: #555; font-size: 8pt; text-transform: uppercase; }\n.value { font-weight: 600; }\n.items { border-collapse: collapse; width: 100%; }\n.items th, .items td { border: 1px solid #aaa; padding: 5px; }\n.items th { background: #eee; text-align: left; }\n.signoff { margin-top: 30px; width: 100%; }\n.signoff td { border-top: 1px solid #555; padding-top: 5px; text-align: center; }\n</style>\n<div class=\"header\"><div class=\"title\">MR BLACK</div><div>INWARD GATE PASS</div></div>\n<table class=\"meta\"><tr><td><span class=\"label\">Gate Pass</span><br><span class=\"value\">{{ doc.name }}</span></td><td><span class=\"label\">Entry Time</span><br><span class=\"value\">{{ doc.get_formatted(\"entry_time\") }}</span></td></tr><tr><td><span class=\"label\">Supplier</span><br><span class=\"value\">{{ doc.supplier }}</span></td><td><span class=\"label\">Purchase Order</span><br><span class=\"value\">{{ doc.purchase_order or \"Not provided\" }}</span></td></tr><tr><td><span class=\"label\">Vehicle</span><br><span class=\"value\">{{ doc.vehicle_no }}</span></td><td><span class=\"label\">Driver</span><br><span class=\"value\">{{ doc.driver_name or \"\" }} {{ doc.driver_phone or \"\" }}</span></td></tr><tr><td><span class=\"label\">Challan No</span><br><span class=\"value\">{{ doc.challan_no or \"\" }}</span></td><td><span class=\"label\">Packages</span><br><span class=\"value\">{{ doc.packages or 0 }}</span></td></tr></table>\n<table class=\"items\"><thead><tr><th>Item</th><th>Expected Qty</th><th>Declared Qty</th></tr></thead><tbody>{% for row in doc.items %}<tr><td>{{ row.item_code }}{% if row.item_name %}<br>{{ row.item_name }}{% endif %}</td><td>{{ row.expected_qty }}</td><td>{{ row.declared_qty }}</td></tr>{% endfor %}</tbody></table>\n<p><b>Status:</b> {{ doc.status }}</p>\n<table class=\"signoff\"><tr><td>Security Guard</td><td>Storekeeper</td></tr></table>"
  }
]
