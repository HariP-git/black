    "paper_size": "A4",
    "html": "<style>\n@page {\n\tsize: A4;\n\tmargin: 0;\n}\n\n.print-format {\n\twidth: 210mm;\n\tpadding: 9mm 12mm 10mm;\n\tbox-sizing: border-box;\n\tcolor: #1f2937;\n\tfont-family: Arial, Helvetica, sans-serif;\n\tfont-size: 10.5pt;\n}\n\n.print-format table,\n.print-format tr,\n.print-format td,\n.print-format div,\n.print-format p {\n\tline-height: 145%;\n\tvertical-align: middle;\n}\n\n.invoice-header {\n\twidth: 100%;\n\tborder-bottom: 3px solid #c89b3c;\n\tpadding-bottom: 12px;\n\tmargin-bottom: 10px;\n}\n\n.invoice-header td {\n\tborder: 0 !important;\n\tpadding: 0 !important;\n}\n\n.brand-logo {\n\twidth: 76px;\n\theight: 76px;\n\tobject-fit: contain;\n\tborder-radius: 12px;\n}\n\n.brand-name {\n\tcolor: #172554;\n\tfont-size: 22px;\n\tfont-weight: 700;\n\tletter-spacing: 2px;\n}\n\n.brand-tagline {\n\tcolor: #6b7280;\n\tfont-size: 9px;\n\tletter-spacing: 1.5px;\n\ttext-transform: uppercase;\n}\n\n.header-contact {\n\tcolor: #4b5563;\n\tfont-size: 9px;\n\tline-height: 160%;\n\ttext-align: right;\n}\n\n.invoice-title {\n\tcolor: #172554;\n\tfont-size: 18px;\n\tfont-weight: 700;\n\tletter-spacing: 1px;\n\ttext-transform: uppercase;\n}\n\n.invoice-meta {\n\tbackground: #f3f4f6;\n\tborder-left: 4px solid #c89b3c;\n\tpadding: 8px 10px;\n\tmargin-bottom: 16px;\n}\n\n.invoice-meta td {\n\tborder: 0 !important;\n\tpadding: 2px 8px !important;\n}\n\n.table {\n\tborder-color: #d1d5db;\n}\n\n.table thead th {\n\tbackground: #172554;\n\tborder-color: #172554;\n\tcolor: #ffffff;\n\tfont-size: 9.5pt;\n\tpadding: 8px 7px !important;\n\ttext-transform: uppercase;\n}\n\n.table tbody td {\n\tborder-color: #e5e7eb;\n\tpadding: 7px !important;\n}\n\n.no-border td {\n\tborder: 0 !important;\n\tpadding: 4px 7px !important;\n}\n\n.feedback-qr {\n\tmargin: 14px auto 10px;\n\tpage-break-inside: avoid;\n\ttext-align: center;\n}\n\n.feedback-qr img {\n\tdisplay: inline-block;\n\twidth: 110px;\n\theight: 110px;\n}\n\n.feedback-caption {\n\tcolor: #374151;\n\tfont-size: 9pt;\n\tmargin-top: 6px;\n}\n\n.invoice-footer {\n\tborder-top: 1px solid #d1d5db;\n\tcolor: #6b7280;\n\tfont-size: 8.5pt;\n\tline-height: 160%;\n\tmargin-top: 10px;\n\tpadding-top: 7px;\n\ttext-align: center;\n}\n\n.footer-brand {\n\tcolor: #172554;\n\tfont-size: 10pt;\n\tfont-weight: 700;\n\tletter-spacing: 2px;\n}\n</style>\n\n<table class=\"invoice-header\">\n\t<tbody><tr>\n\t\t<td style=\"width: 58%;\">\n\t\t\t<table><tbody><tr>\n\t\t\t\t<td style=\"width: 88px;\"><img class=\"brand-logo\" src=\"/files/logo.png\" alt=\"Mr Black logo\"></td>\n\t\t\t\t<td>\n\t\t\t\t\t<div class=\"brand-name\">MR BLACK</div>\n\t\t\t\t\t<div class=\"brand-tagline\">Fashion &amp; Lifestyle</div>\n\t\t\t\t</td>\n\t\t\t</tr></tbody></table>\n\t\t</td>\n\t\t<td class=\"header-contact\" style=\"width: 42%;\">\n\t\t\t<div class=\"invoice-title\">{{ doc.select_print_heading or _(\"Invoice\") }}</div>\n\t\t\t<div>{{ doc.company }}</div>\n\t\t\t<div>2/39, Porur, Chennai</div>\n\t\t\t<div>Phone: 9384439305</div>\n\t\t</td>\n\t</tr></tbody>\n</table>\n\n<table class=\"invoice-meta\" style=\"width: 100%;\"><tbody><tr>\n\t<td style=\"width: 50%;\"><b>{{ _(\"Receipt No\") }}:</b> {{ doc.name }}</td>\n\t<td style=\"width: 50%;\"><b>{{ _(\"Date\") }}:</b> {{ doc.get_formatted(\"posting_date\") }}</td>\n</tr><tr>\n\t<td><b>{{ _(\"Customer\") }}:</b> {{ doc.customer_name }}</td>\n\t<td><b>{{ _(\"Cashier\") }}:</b> {{ doc.owner }}</td>\n</tr></tbody></table>\n\n\n\n\n\n<hr>\n<table class=\"table table-condensed\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th width=\"50%\">{{ _(\"Item\") }}</th>\n\t\t\t<th width=\"25%\" class=\"text-right\">{{ _(\"Qty\") }}</th>\n\t\t\t<th width=\"25%\" class=\"text-right\">{{ _(\"Amount\") }}</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t{%- for item in doc.items -%}\n\t\t<tr>\n\t\t\t<td>\n\t\t\t\t{{ item.item_code }}\n\t\t\t\t{%- if item.item_name != item.item_code -%}\n\t\t\t\t\t<br>{{ item.item_name }}\n\t\t\t\t{%- endif -%}\n\t\t\t\t{%- if item.serial_no -%}\n\t\t\t\t\t<br><b>{{ _(\"SR.No\") }}:</b><br>\n\t\t\t\t\t{{ item.serial_no | replace(\"\\n\", \", \") }}\n\t\t\t\t{%- endif -%}\n\t\t\t</td>\n\t\t\t<td class=\"text-right\">{{ item.qty }}<br>@ {{ item.get_formatted(\"rate\") }}</td>\n\t\t\t<td class=\"text-right\">{{ item.get_formatted(\"amount\") }}</td>\n\t\t</tr>\n\t\t{%- endfor -%}\n\t</tbody>\n</table>\n<table class=\"table table-condensed no-border\">\n\t<tbody>\n\t\t<tr>\n\t\t\t{% if doc.flags.show_inclusive_tax_in_print %}\n\t\t\t\t<td class=\"text-right\" style=\"width: 70%\">\n\t\t\t\t\t{{ _(\"Total Excl. Tax\") }}\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\">\n\t\t\t\t\t{{ doc.get_formatted(\"net_total\", doc) }}\n\t\t\t\t</td>\n\t\t\t{% else %}\n\t\t\t\t<td class=\"text-right\" style=\"width: 70%\">\n\t\t\t\t\t{{ _(\"Total\") }}\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\">\n\t\t\t\t\t{{ doc.get_formatted(\"total\", doc) }}\n\t\t\t\t</td>\n\t\t\t{% endif %}\n\t\t</tr>\n\t\t{%- for row in doc.taxes -%}\n\t\t  {%- if not row.included_in_print_rate or doc.flags.show_inclusive_tax_in_print -%}\n\t\t\t<tr>\n\t\t\t\t<td class=\"text-right\" style=\"width: 70%\">\n\t\t\t\t    {% if '%' in row.description %}\n\t\t\t\t\t    {{ row.description }}\n\t\t\t\t\t{% else %}\n\t\t\t\t\t    {{ row.description }}@{{ row.rate }}%\n\t\t\t\t\t{% endif %}\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\">\n\t\t\t\t\t{{ row.get_formatted(\"tax_amount\", doc) }}\n\t\t\t\t</td>\n\t\t\t<tr>\n\t\t  {%- endif -%}\n\t\t{%- endfor -%}\n\n\t\t{%- if doc.discount_amount -%}\n\t\t<tr>\n\t\t\t<td class=\"text-right\" style=\"width: 75%\">\n\t\t\t\t{{ _(\"Discount\") }}\n\t\t\t</td>\n\t\t\t<td class=\"text-right\">\n\t\t\t\t{{ doc.get_formatted(\"discount_amount\") }}\n\t\t\t</td>\n\t\t</tr>\n\t\t{%- endif -%}\n\t\t<tr>\n\t\t\t<td class=\"text-right\" style=\"width: 75%\">\n\t\t\t\t<b>{{ _(\"Grand Total\") }}</b>\n\t\t\t</td>\n\t\t\t<td class=\"text-right\">\n\t\t\t\t{{ doc.get_formatted(\"grand_total\") }}\n\t\t\t</td>\n\t\t</tr>\n\t\t{%- if doc.rounded_total -%}\n\t\t<tr>\n\t\t\t<td class=\"text-right\" style=\"width: 75%\">\n\t\t\t\t<b>{{ _(\"Rounded Total\") }}</b>\n\t\t\t</td>\n\t\t\t<td class=\"text-right\">\n\t\t\t\t{{ doc.get_formatted(\"rounded_total\") }}\n\t\t\t</td>\n\t\t</tr>\n\t\t{%- endif -%}\n\t\t{%- for row in doc.payments -%}\n\t\t\t<tr>\n\t\t\t\t<td class=\"text-right\" style=\"width: 70%\">\n\t\t\t\t    {{ row.mode_of_payment }}\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\">\n\t\t\t\t\t{{ row.get_formatted(\"amount\", doc) }}\n\t\t\t\t</td>\n\t\t\t<tr>\n\t\t{%- endfor -%}\n\t\t<tr>\n\t\t\t<td class=\"text-right\" style=\"width: 75%\">\n\t\t\t\t<b>{{ _(\"Paid Amount\") }}</b>\n\t\t\t</td>\n\t\t\t<td class=\"text-right\">\n\t\t\t\t{{ doc.get_formatted(\"paid_amount\") }}\n\t\t\t</td>\n\t\t</tr>\n\t\t{%- if doc.change_amount -%}\n\t\t\t<tr>\n\t\t\t\t<td class=\"text-right\" style=\"width: 75%\">\n\t\t\t\t\t<b>{{ _(\"Change Amount\") }}</b>\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\">\n\t\t\t\t\t{{ doc.get_formatted(\"change_amount\") }}\n\t\t\t\t</td>\n\t\t\t</tr>\n\t\t{%- endif -%}\n\t</tbody>\n</table>\n<hr>\n<p>{{ doc.terms or \"\" }}</p>\n\n<div class=\"feedback-qr\">\n\t<img src=\"/assets/cloting/images/feedback_qr.png\" alt=\"Customer feedback QR code\">\n\t<div class=\"feedback-caption\">Scan to share your feedback with Mr Black</div>\n</div>\n\n<div class=\"invoice-footer\">\n\t<div class=\"footer-brand\">MR BLACK</div>\n\t<div>Thank you for shopping with us.</div>\n\t<div>9384439305 &nbsp; | &nbsp; 2/39, Porur, Chennai</div>\n</div>",
    "css": null
  },
  {
    "doctype": "Print Format",
    "name": "Manufacturing Sales Order",
    "doc_type": "Sales Order",
    "module": "Clothing",
    "standard": "No",
    "custom_format": 1,
    "print_format_type": "Jinja",
    "paper_size": "A4",
    "pdf_generator": "chrome",
    "margin_top": 10.0,
    "margin_bottom": 10.0,
