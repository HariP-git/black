    "html": "<style>\n@page { size: A4; margin: 0; }\n.print-format {\n\twidth: 210mm;\n\tmin-height: 297mm;\n\tpadding: 12mm 13mm;\n\tbox-sizing: border-box;\n\tcolor: #202124;\n\tfont-family: Arial, Helvetica, sans-serif;\n\tfont-size: 9.5pt;\n}\n.print-format table { width: 100%; border-collapse: collapse; }\n.print-format td, .print-format th { vertical-align: top; }\n.brand-header { border-bottom: 3px solid #b28a3c; padding-bottom: 10px; }\n.brand-logo { width: 64px; height: 64px; object-fit: contain; }\n.brand-name { color: #172554; font-size: 20px; font-weight: 700; letter-spacing: 2px; }\n.brand-subtitle { color: #777; font-size: 8px; letter-spacing: 1.4px; text-transform: uppercase; }\n.document-title { color: #172554; font-size: 17px; font-weight: 700; text-align: right; text-transform: uppercase; }\n.document-meta { color: #555; font-size: 8.5pt; line-height: 155%; text-align: right; }\n.section-title { background: #172554; color: #fff; font-size: 9pt; font-weight: 700; letter-spacing: .5px; padding: 6px 8px; text-transform: uppercase; }\n.info-box { background: #f3f4f6; border-left: 4px solid #b28a3c; margin-top: 12px; padding: 8px; }\n.info-box td { padding: 2px 8px; }\n.label { color: #777; font-size: 8pt; text-transform: uppercase; }\n.value { font-weight: 600; }\n.data-table { margin-top: 12px; }\n.data-table th { background: #e9eaec; color: #172554; font-size: 8pt; padding: 7px 6px; text-align: left; text-transform: uppercase; }\n.data-table td { border-bottom: 1px solid #ddd; padding: 7px 6px; }\n.text-right { text-align: right; }\n.fitting-card { border: 1px solid #d6d8dc; margin-top: 12px; page-break-inside: avoid; }\n.fitting-card-title { background: #f7f7f5; color: #172554; font-weight: 700; padding: 7px 8px; }\n.fitting-card td { border-top: 1px solid #e5e7eb; padding: 6px 8px; width: 25%; }\n.fitting-card .label { display: block; margin-bottom: 2px; }\n.fitting-card .value { display: block; white-space: pre-line; }\n.design-image { max-height: 130px; max-width: 130px; margin-top: 4px; }\n.signoff { margin-top: 24px; }\n.signoff td { border-top: 1px solid #777; padding-top: 6px; text-align: center; width: 33%; }\n.footer { border-top: 1px solid #d1d5db; color: #777; font-size: 8pt; margin-top: 24px; padding-top: 7px; text-align: center; }\n</style>\n\n<table class=\"brand-header\">\n\t<tr>\n\t\t<td style=\"width: 60%;\">\n\t\t\t<table><tr>\n\t\t\t\t<td style=\"width: 74px;\"><img class=\"brand-logo\" src=\"/files/logo.png\" alt=\"Mr Black\"></td>\n\t\t\t\t<td>\n\t\t\t\t\t<div class=\"brand-name\">MR BLACK</div>\n\t\t\t\t\t<div class=\"brand-subtitle\">Manufacturing Work Sheet</div>\n\t\t\t\t</td>\n\t\t\t</tr></table>\n\t\t</td>\n\t\t<td style=\"width: 40%;\">\n\t\t\t<div class=\"document-title\">Production Brief</div>\n\t\t\t<div class=\"document-meta\">\n\t\t\t\tSales Order: <b>{{ doc.name }}</b><br>\n\t\t\t\tOrder Date: {{ doc.get_formatted(\"transaction_date\") }}<br>\n\t\t\t\t{% if doc.delivery_date %}Required By: {{ doc.get_formatted(\"delivery_date\") }}<br>{% endif %}\n\t\t\t\tStatus: {{ doc.status }}\n\t\t\t</div>\n\t\t</td>\n\t</tr>\n</table>\n\n<table class=\"info-box\">\n\t<tr>\n\t\t<td style=\"width: 50%;\">\n\t\t\t<span class=\"label\">Customer</span>\n\t\t\t<span class=\"value\">{{ doc.customer_name or doc.customer }}</span><br>\n\t\t\t{% if doc.contact_person %}<span class=\"label\">Contact</span> {{ doc.contact_person }}<br>{% endif %}\n\t\t\t{% if doc.contact_phone %}<span class=\"label\">Phone</span> {{ doc.contact_phone }}<br>{% endif %}\n\t\t\t{% if doc.contact_email %}<span class=\"label\">Email</span> {{ doc.contact_email }}{% endif %}\n\t\t</td>\n\t\t<td style=\"width: 50%;\">\n\t\t\t<span class=\"label\">Customer Type</span>\n\t\t\t<span class=\"value\">{{ doc.custom_customer_type or \"Individual\" }}</span><br>\n\t\t\t{% if doc.address_display %}<span class=\"label\">Address</span><br>{{ doc.address_display }}{% endif %}\n\t\t</td>\n\t</tr>\n</table>\n\n<div class=\"section-title\" style=\"margin-top: 14px;\">Items for Production</div>\n<table class=\"data-table\">\n\t<thead><tr>\n\t\t<th style=\"width: 5%;\">No.</th>\n\t\t<th style=\"width: 18%;\">Item Code</th>\n\t\t<th style=\"width: 35%;\">Description</th>\n\t\t<th style=\"width: 12%;\">Qty</th>\n\t\t<th style=\"width: 12%;\">UOM</th>\n\t\t<th style=\"width: 18%;\">Delivery Date</th>\n\t</tr></thead>\n\t<tbody>\n\t\t{% for item in doc.items %}\n\t\t<tr>\n\t\t\t<td>{{ item.idx }}</td>\n\t\t\t<td><b>{{ item.item_code }}</b></td>\n\t\t\t<td>{{ item.item_name or item.description }}</td>\n\t\t\t<td class=\"text-right\">{{ item.qty }}</td>\n\t\t\t<td>{{ item.uom }}</td>\n\t\t\t<td>{{ item.get_formatted(\"delivery_date\") if item.delivery_date else \"\" }}</td>\n\t\t</tr>\n\t\t{% endfor %}\n\t</tbody>\n</table>\n\n{% if doc.custom_is_customized and doc.custom_customer_details_ %}\n<div class=\"section-title\" style=\"margin-top: 16px;\">Individual Fitting & Customization Instructions</div>\n{% for row in doc.custom_customer_details_ %}\n<table class=\"fitting-card\">\n\t<tr><td colspan=\"4\" class=\"fitting-card-title\">Fitting Detail {{ loop.index }}</td></tr>\n\t<tr>\n\t\t<td><span class=\"label\">Garment Item</span><span class=\"value\">{{ row.garment_item }}</span></td>\n\t\t<td><span class=\"label\">Category</span><span class=\"value\">{{ row.garment_category }}</span></td>\n\t\t<td><span class=\"label\">Style</span><span class=\"value\">{{ row.garment_style }}</span></td>\n\t\t<td><span class=\"label\">Fabric</span><span class=\"value\">{{ row.fabric or \"Not specified\" }}</span></td>\n\t</tr>\n\t<tr>\n\t\t<td><span class=\"label\">Colour</span><span class=\"value\">{{ row.colour }}</span></td>\n\t\t<td><span class=\"label\">Fit Preference</span><span class=\"value\">{{ row.fit_preference or \"Not specified\" }}</span></td>\n\t\t<td><span class=\"label\">Customization</span><span class=\"value\">{{ row.customization_type or \"Not specified\" }}</span></td>\n\t\t<td><span class=\"label\">Measurement Unit</span><span class=\"value\">{{ row.measurement_unit }}</span></td>\n\t</tr>\n\t<tr>\n\t\t<td colspan=\"2\"><span class=\"label\">Measurement Name</span><span class=\"value\">{{ row.measurement_name }}</span></td>\n\t\t<td colspan=\"2\"><span class=\"label\">Measurement Value</span><span class=\"value\">{{ row.measurment_value }}</span></td>\n\t</tr>\n\t<tr>\n\t\t<td colspan=\"3\"><span class=\"label\">Customer Instructions</span><span class=\"value\">{{ row.customer_instructions or \"None\" }}</span></td>\n\t\t<td>\n\t\t\t<span class=\"label\">Design Reference</span>\n\t\t\t{% if row.design_reference %}<img class=\"design-image\" src=\"{{ row.design_reference }}\">{% else %}<span class=\"value\">None</span>{% endif %}\n\t\t</td>\n\t</tr>\n</table>\n{% endfor %}\n{% endif %}\n\n{% if doc.custom_is_customized and doc.custom_customer_company_details %}\n<div class=\"section-title\" style=\"margin-top: 16px;\">Company Customization Requirements</div>\n<table class=\"data-table\">\n\t<thead><tr><th>Garment</th><th>Category</th><th>Style</th><th>Colour</th><th>Size</th><th>Qty</th><th>Branding</th><th>Personalization</th></tr></thead>\n\t<tbody>{% for row in doc.custom_customer_company_details %}<tr>\n\t\t<td>{{ row.garment_item }}</td><td>{{ row.garment_category }}</td><td>{{ row.garment_style }}</td>\n\t\t<td>{{ row.colour }}</td><td>{{ row.size }}</td><td>{{ row.quantity }}</td>\n\t\t<td>{{ row.branding_type }}</td><td>{{ row.personalization_name }}</td>\n\t</tr>{% endfor %}</tbody>\n</table>\n{% endif %}\n\n<table class=\"signoff\">\n\t<tr><td>Prepared By</td><td>Manufacturing Checked By</td><td>Customer/Manager Approval</td></tr>\n</table>\n<div class=\"footer\">MR BLACK &nbsp; | &nbsp; 9384439305 &nbsp; | &nbsp; 2/39, Porur, Chennai &nbsp; | &nbsp; Manufacturing copy</div>\n"
  },
  {
    "doctype": "Print Format",
    "name": "Gate Pass Inward Slip",
    "doc_type": "Gate Pass",
    "module": "Clothing",
